# Copie este arquivo para .env (cp .env.example .env) e ajuste se precisar.
# O .env NUNCA vai para o Git: ele pode ter senhas.

# Banco de dados (usado pelo Postgres e pela API)
POSTGRES_USER=workhub
POSTGRES_PASSWORD=workhub
POSTGRES_DB=workhub
# "localhost" para rodar a API fora do Docker.
# No Docker Compose esse valor é trocado por "db" automaticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Endereços do front que podem chamar a API, separados por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Portas no seu computador. Mude se alguma já estiver em uso
# (ex.: outro projeto rodando). Se mudar API_PORT, ajuste o VITE_API_URL do
# frontend/.env; se mudar WEB_PORT, ajuste o CORS_ORIGINS acima.
API_PORT=8000
WEB_PORT=5173
